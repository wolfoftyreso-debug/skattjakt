# Skattjakt configuration. Copy to .env; never commit the filled-in file.

# --- required --------------------------------------------------------------

# The model this deployment uses. There is deliberately no default: naming the
# model is part of the audit trail, and a default outlives its own accuracy.
# Use the strongest suitable Anthropic model available at deployment time —
# see https://platform.claude.com/docs/en/about-claude/models/overview
SKATTJAKT_MODEL_ID=

ANTHROPIC_API_KEY=

# Bearer token for the /v1 routes. When unset, those routes are closed.
SKATTJAKT_API_TOKEN=

# --- optional --------------------------------------------------------------

DATABASE_URL=postgres://postgres:skattjakt@localhost:5432/skattjakt
PORT=8080
RUST_LOG=skattjakt=info

# Seconds. Analyses at high effort can legitimately take minutes.
SKATTJAKT_MODEL_TIMEOUT_SECS=600
SKATTJAKT_MODEL_MAX_RETRIES=3

# Re-run a request the model's safety classifiers decline on a fallback model.
# On by default; financial documents occasionally trip classifiers on benign
# content. Set to 0 to disable.
SKATTJAKT_MODEL_FALLBACK=1

ANTHROPIC_BASE_URL=https://api.anthropic.com

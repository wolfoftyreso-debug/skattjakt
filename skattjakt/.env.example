# Skattjakt configuration. Copy to .env; never commit the filled-in file.

# --- required --------------------------------------------------------------

# The model this deployment uses. There is deliberately no default: naming the
# model is part of the audit trail, and a default outlives its own accuracy.
# Use the strongest suitable Anthropic model available at deployment time —
# see https://platform.claude.com/docs/en/about-claude/models/overview
SKATTJAKT_MODEL_ID=

ANTHROPIC_API_KEY=

# Bearer token for the /v1 routes. When unset, those routes are closed.
SKATTJAKT_API_TOKEN=

# --- optional --------------------------------------------------------------

DATABASE_URL=postgres://postgres:skattjakt@localhost:5432/skattjakt
PORT=8080
RUST_LOG=skattjakt=info,sqlx=warn

# Token that may create companies. Grants access to no company's data.
SKATTJAKT_ADMIN_TOKEN=

# Where uploaded documents are stored.
SKATTJAKT_BLOB_ROOT=./data/documents

# Model prices, micro-ore per million tokens, keyed by model id. A model with
# no entry here cannot be called at all: an unpriced call is an unbounded one,
# and the per-analysis cost ceiling would not exist for it.
SKATTJAKT_MODEL_PRICES={}

# The per-analysis cost ceiling, in SEK. Per analysis rather than per month: a
# monthly cap is discovered on the 28th, when it has already been paid.
SKATTJAKT_ANALYSIS_BUDGET_SEK=25

# Seconds. Analyses at high effort can legitimately take minutes.
SKATTJAKT_MODEL_TIMEOUT_SECS=600
SKATTJAKT_MODEL_MAX_RETRIES=3

# Whether a request may be served by a model other than the one named above.
#
# On by default: financial documents occasionally trip a provider's safety
# classifiers on entirely benign content, and a refused analysis is a worse
# outcome for the customer than one served by a sibling model. Read by both the
# provider client and the gateway from one place, so they cannot disagree.
#
# Nothing is hidden by this. Every fallback is stored with both model names and
# raises SkattjaktModelFallbacks. Set to 0 where reproducibility outweighs
# availability; the gateway will then refuse a fallback response outright.
SKATTJAKT_MODEL_FALLBACK=1

ANTHROPIC_BASE_URL=https://api.anthropic.com
